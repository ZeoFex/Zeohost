# DATABASE Connection from Neon (Prisma)
 
DATABASE_URL=

# ---------------------------------------------------------------------------
# name.com Core API (wholesale registrar)
# Create tokens at https://www.name.com/account/settings/api
# Docs: https://docs.name.com/guides/getting-started
# Sandbox is API-only: https://api.dev.name.com
# Production: https://api.name.com
# ---------------------------------------------------------------------------
DOMAIN_PROVIDER=namecom
DNS_PROVIDER=namecom

# Account username from name.com (not your email if you can avoid it).
# For sandbox, use username-test (we append -test if NAMECOM_ENV=sandbox and it is missing).
NAMECOM_USERNAME=

# API token from Account Settings → API Tokens.
# Use the Development token with sandbox, Production token with live.
NAMECOM_API_TOKEN=

# sandbox | production
NAMECOM_ENV=sandbox

# Optional. Defaults from NAMECOM_ENV.
# NAMECOM_API_BASE_URL=https://api.dev.name.com
# NAMECOM_API_PREFIX=/core/v1

# Optional aliases (used if NAMECOM_USERNAME / NAMECOM_API_TOKEN are empty)
DOMAIN_PROVIDER_API_KEY=
DOMAIN_PROVIDER_API_SECRET=

# Optional default WHOIS contacts for registrations.
# If left empty, name.com applies your account default contacts.
NAMECOM_CONTACT_FIRST_NAME=
NAMECOM_CONTACT_LAST_NAME=
NAMECOM_CONTACT_ORG=
NAMECOM_CONTACT_EMAIL=
NAMECOM_CONTACT_PHONE=
NAMECOM_CONTACT_ADDRESS1=
NAMECOM_CONTACT_CITY=
NAMECOM_CONTACT_STATE=
NAMECOM_CONTACT_ZIP=
NAMECOM_CONTACT_COUNTRY=GH

# Optional webhook so name.com can push domain events into this app.
# Point this at https://YOUR-DOMAIN/api/webhooks/namecom after you deploy.
# Signatures are verified with NAMECOM_API_TOKEN (name.com HMAC). URL must match exactly.
NAMECOM_WEBHOOK_URL=
# Optional. Prefer leaving blank; verification uses NAMECOM_API_TOKEN.
NAMECOM_WEBHOOK_SECRET=
# Optional replay window in seconds (default 300).
# NAMECOM_WEBHOOK_MAX_AGE_SECONDS=300

# Hosting has no live driver yet — mock provisions local plan records only.
HOSTING_PROVIDER=mock
HOSTING_PROVIDER_API_KEY=
HOSTING_PROVIDER_API_SECRET=

# paystack | mock
PAYMENT_PROVIDER=paystack
NOTIFICATION_PROVIDER=smtp
PAYMENT_PROVIDER_SECRET_KEY=

# SMTP — Namecheap Private Email (or any SMTP)
# Host for Namecheap: mail.privateemail.com | Port 465 SSL (or 587 with SMTP_SECURE=false)
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
# Fallback login if a purpose-specific user/pass is not set
SMTP_USER=support@zeohost.store
SMTP_PASS=
SMTP_FROM="Zeohost <support@zeohost.store>"

# Per-purpose From addresses (Namecheap Private Email on zeohost.store)
# Welcome after signup → welcome@zeohost.store
SMTP_FROM_WELCOME="Zeohost <welcome@zeohost.store>"
SMTP_USER_WELCOME=welcome@zeohost.store
SMTP_PASS_WELCOME=
# Password reset / email verification OTP → support@zeohost.store
SMTP_FROM_SUPPORT="Zeohost Support <support@zeohost.store>"
SMTP_USER_SUPPORT=support@zeohost.store
SMTP_PASS_SUPPORT=
# Domain / order emails → sales@zeohost.store
SMTP_FROM_SALES="Zeohost Sales <sales@zeohost.store>"
SMTP_USER_SALES=sales@zeohost.store
SMTP_PASS_SALES=

# Authentication — REQUIRED: random string, at least 32 characters. No fallback.
# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# GitHub OAuth App — https://github.com/settings/developers
# Homepage URL: {NEXT_PUBLIC_APP_URL}
# Authorization callback URL: {NEXT_PUBLIC_APP_URL}/api/auth/github/callback
# The `repo` scope is required to list and inspect private repositories.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Docker image used by the isolated build + SSR runtime worker.
BUILD_IMAGE=node:22-alpine
# Preview host for SSR apps. Subdomains resolve to 127.0.0.1 via lvh.me locally.
# Production: point *.preview.yourdomain.com at this server and set the same value.
PREVIEW_ROOT_DOMAIN=lvh.me
RUNTIME_PORT_MIN=4100
RUNTIME_PORT_MAX=4599
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack (live keys charge real money)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Catalog prices are USD cents; convert when charging in GHS/NGN
PAYSTACK_CURRENCY=GHS
PAYSTACK_GHS_PER_USD=11.77
PAYSTACK_NGN_PER_USD=1600

# SMS / OTP infrastructure.
# mock is the development connector. It does not reach a mobile network.
# Do not put carrier, SMPP, or aggregator credentials here until a real connector exists.
SMS_CONNECTOR=mock
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_PHONE=5
OTP_MAX_PER_IP=20
OTP_MAX_PER_PROJECT=100
OTP_WINDOW_SECONDS=600
SMS_MAX_RETRIES=5
SMS_MAX_PER_PROJECT=60
SMS_WINDOW_SECONDS=60
SMS_DEFAULT_SENDER=Zeohost
# Key used when someone creates an account. The phone is saved on the customer,
# and a signup text is queued on this key so it shows in SMS & OTP.
SMS_PLATFORM_API_KEY=
